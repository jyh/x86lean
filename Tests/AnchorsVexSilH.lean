/-
# Tests.AnchorsVexSilH — D375: the VEX.256 128-bit lane insert and extract, against a processor

A NEW metered unit (D375 prediction 3), judged once against an absolute registration measured on its own machine
(`scripts/kernel_ceilings.txt`, `scripts/ku_delta_budget.txt`).

The block between the markers is GENERATED by `hwprobe/mk_vexsilh_anchors.py` (`--check` gates it byte for byte). The
helpers restate `Tests.AnchorsVexSilF`'s (D371), private to that module, renamed `vh…`.

LANE. Personal lane, public sources only.
-/
import X86

namespace X86.Tests.VexSilH
open X86

/-! ## D375 — VINSERTI128 VINSERTF128 (from xmm and m128) and VEXTRACTI128 VEXTRACTF128 (to xmm and m128), at six imm8
values, against a processor's reading

⚠️ NONE OF THESE HAS A DIFFERENTIAL PARTNER: ACL2 x86isa refuses all eight encodings while it executes `vpxor m,xmm` and
`vpaddw ymm` in the same run (D375 P1).  The rows below — run by `hwprobe/vexsilf_probe.c` against `vexsilh_rows.h`,
derived by `hwprobe/mk_vexsilh_rows.py` and re-derived there from byte lists — are the only check of these numbers.

A row agrees when the step did not refuse, YMM3 holds the row's 256 bits (for an extract to xmm, its upper half zero; for
a store, unchanged), YMM1 and YMM2 are unchanged, RAX and MXCSR are unchanged, the six flags are `f`, RIP moved by the
instruction's length, and, for a store, the qwords its 16 bytes span equal the expected buffer's.  The three forms that
do not store leave memory alone: the frame theorems below.  ⚠️ What a store writes OUTSIDE the qwords it spans is not
checked per row; it is `writeMem128` by definition, and the probe compares the whole 64-byte buffer on silicon. -/

/-- The six arithmetic flags of an RFLAGS image (CF PF AF ZF SF OF at bits 0 2 4 6 7 11); DF stays clear. -/
private def vhFlags (f : BitVec 64) : Flags :=
  ⟨f.getLsbD 0, f.getLsbD 2, f.getLsbD 4, f.getLsbD 6, f.getLsbD 7, f.getLsbD 11, false⟩

/-- The RFLAGS image of the flags this model keeps, at `flagFields`' positions. -/
private def vhRflags (f : Flags) : BitVec 64 :=
  flagFields.foldl (fun acc r => acc ||| (if r.get f then (1 : BitVec 64) <<< r.bit else 0)) 0

/-- Load a whole 256-bit YMM register: the low half through `setXmm`, the upper half into `Xmms.hi`. -/
private def vhSetYmm (c : Cpu) (r : XmmReg) (y : BitVec 256) : Cpu :=
  let c := c.setXmm r (y.setWidth 128)
  { c with xmm := { c.xmm with hi := c.xmm.hi.set r ((y >>> 128).setWidth 128) } }

/-- The whole 256-bit YMM register. -/
private def vhYmm (t : Cpu) (r : XmmReg) : BitVec 256 :=
  ((t.getYmmHi r).setWidth 256 <<< 128) ||| (t.getXmm r).setWidth 256

/-- Where the row's 64-byte buffer lives in the model's memory (any address does; the probe's is a stack object). -/
private def vhBuf : BitVec 64 := 0x10000

/-- `vexsilh_ops.S`'s pre-state (D371's frame, `vexsilf_ops.S`), at RIP 0x400000: registers as D361's, MXCSR 0x1F80, the operand's qwords written
(`(index, value)` pairs), RBX = `vhBuf + off`. -/
private def vhPre (y1 y2 y3 : BitVec 256) (f : BitVec 64) (rax : BitVec 64) (mem : List (Nat × BitVec 64))
    (off : BitVec 64) : Cpu :=
  let c := (vhSetYmm (vhSetYmm (vhSetYmm ({ flags := vhFlags f, rip := 0x400000, mxcsr := 0x1f80, oracle := Oracle.zero }
    : Cpu) .x1 y1) .x2 y2) .x3 y3).setReg .q .rax rax
  let c := mem.foldl (fun c (j, q) => c.writeMem .q (vhBuf + BitVec.ofNat 64 (8 * j)) q) c
  c.setReg .q .rbx (vhBuf + off)

private def vhAgrees (t : Cpu) (n : Nat) (y1 y2 : BitVec 256) (f : BitVec 64) (w3 : BitVec 256) (wrax : BitVec 64)
    (wq : List (Nat × BitVec 64)) : Bool :=
  t.ms.isNone && vhYmm t .x3 == w3 && vhYmm t .x1 == y1 && vhYmm t .x2 == y2
    && t.getReg .q .rax == wrax && t.mxcsr == 0x1f80
    && (vhRflags t.flags &&& 0x8d5) == (f &&& 0x8d5) && t.rip == 0x400000 + BitVec.ofNat 64 n
    && wq.all (fun (j, q) => t.readMem .q (vhBuf + BitVec.ofNat 64 (8 * j)) == q)


/-! ### The memory frame: `step` leaves `mem` unchanged for the insert forms and the extract to a register (D375) -/

theorem vh_frame_ins128 (fp : Bool) (d s1 s2 : XmmReg) (imm : BitVec 8) (len : Nat) (s : Cpu) (h : Live s) :
    (step ⟨.vex (.vexins128 fp d s1 s2 imm), len⟩ s).mem = s.mem := by
  simp only [step, h, Cpu.stopped]
  split <;> simp_all [Cpu.setYmm, Cpu.setRip, VexOp.anyLocked, Op.anyLocked] <;> split <;> simp_all

theorem vh_frame_ins128m (fp : Bool) (d s1 : XmmReg) (ea : Ea) (imm : BitVec 8) (len : Nat) (s : Cpu) (h : Live s)
    (hl : ea.lock = false) :
    (step ⟨.vex (.vexins128m fp d s1 ea imm), len⟩ s).mem = s.mem := by
  simp only [step, h, Cpu.stopped]
  split <;> simp_all [Cpu.setYmm, Cpu.setRip, VexOp.anyLocked, Op.anyLocked] <;> split <;> simp_all

theorem vh_frame_ext128 (fp : Bool) (d s1 : XmmReg) (imm : BitVec 8) (len : Nat) (s : Cpu) (h : Live s) :
    (step ⟨.vex (.vexext128 fp d s1 imm), len⟩ s).mem = s.mem := by
  simp only [step, h, Cpu.stopped]
  split <;> simp_all [Cpu.setXmmVex128, Cpu.setRip, VexOp.anyLocked, Op.anyLocked]

