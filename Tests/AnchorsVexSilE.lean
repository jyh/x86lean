/-
# Tests.AnchorsVexSilE — D361 (V10): the VEX memory forms of the silicon rows, against a processor

A NEW metered unit (D361 prediction 3), judged once against an absolute registration measured on its own machine
(`scripts/kernel_ceilings.txt`, `scripts/ku_delta_budget.txt`).

The block between the markers is GENERATED by `hwprobe/mk_vexsile_anchors.py` (`--check` gates it byte for byte).

LANE. Personal lane, public sources only.
-/
import X86

namespace X86.Tests.VexSilE
open X86

/-! ## D361 (V10) — VPSHUFB, VPALIGNR (m128), VADDPS VSUBPS VMULPS (m128, m256), VPSRAD (an m128 count at both lengths)
and the m128/m256 forms of VPUNPCKLWD, VPUNPCKHWD, VPUNPCKLBW, VPACKUSWB, against a processor's reading

⚠️ NONE OF THESE HAS A DIFFERENTIAL PARTNER: ACL2 x86isa refuses every one of these encodings while it executes
`vpxor m,xmm` in the same run (D361 P1).  The rows below — run by `hwprobe/vexsile_probe.c`, derived by
`hwprobe/mk_vexsile_rows.py` and held there row by row to an independent textbook — are the only check of these numbers.

The pre-state is the probe's (`hwprobe/vexsile_ops.S`), as V8c's: YMM1-3, RAX, MXCSR and the flags from the row, the
qwords the memory operand spans at `v10Buf`, and RBX = `v10Buf + off`.  A row agrees when the step did not refuse, YMM3
holds the row's 256 bits, YMM1 and YMM2 are unchanged, RAX is the row's, MXCSR is the row's with the FP forms' sticky
flags OR'ed in, the six flags are `f`, RIP moved by the instruction's length.  The rows do not read memory back: the
frame theorems below (`v10_frame_shufbm`, `v10_frame_alignrm`, `v10_frame_parithm`, `v10_frame_parithm256`,
`v10_frame_sraxm`, `v10_frame_sraxm256`) state `(step ⟨.vex op, len⟩ s).mem = s.mem` for each new constructor, for any
`s` with `Live s` and any address with `ea.lock = false` (the unpack kinds go through `vexbinm`/`vexbinm256`, whose
frames are V8c's `X86.Tests.VexSilC.v8c_frame_binm` and `v8c_frame_binm256`, stated for every `VBinKind`). -/

/-- The six arithmetic flags of an RFLAGS image (CF PF AF ZF SF OF at bits 0 2 4 6 7 11); DF stays clear. -/
private def v10Flags (f : BitVec 64) : Flags :=
  ⟨f.getLsbD 0, f.getLsbD 2, f.getLsbD 4, f.getLsbD 6, f.getLsbD 7, f.getLsbD 11, false⟩

/-- The RFLAGS image of the flags this model keeps, at `flagFields`' positions. -/
private def v10Rflags (f : Flags) : BitVec 64 :=
  flagFields.foldl (fun acc r => acc ||| (if r.get f then (1 : BitVec 64) <<< r.bit else 0)) 0

/-- Load a whole 256-bit YMM register: the low half through `setXmm`, the upper half into `Xmms.hi`. -/
private def v10SetYmm (c : Cpu) (r : XmmReg) (y : BitVec 256) : Cpu :=
  let c := c.setXmm r (y.setWidth 128)
  { c with xmm := { c.xmm with hi := c.xmm.hi.set r ((y >>> 128).setWidth 128) } }

/-- The whole 256-bit YMM register. -/
private def v10Ymm (t : Cpu) (r : XmmReg) : BitVec 256 :=
  ((t.getYmmHi r).setWidth 256 <<< 128) ||| (t.getXmm r).setWidth 256

/-- Where the row's 64-byte buffer lives in the model's memory (any address does; the probe's is a stack object). -/
private def v10Buf : BitVec 64 := 0x10000

/-- `vexsile_ops.S`'s pre-state, at RIP 0x400000: registers as V8c's, the operand's qwords written (`(index, value)` pairs), RBX =
`v10Buf + off`. -/
private def v10Pre (y1 y2 y3 : BitVec 256) (f : BitVec 64) (mx : BitVec 32) (rax : BitVec 64) (mem : List (Nat × BitVec 64))
    (off : BitVec 64) : Cpu :=
  let c := (v10SetYmm (v10SetYmm (v10SetYmm ({ flags := v10Flags f, rip := 0x400000, mxcsr := mx, oracle := Oracle.zero }
    : Cpu) .x1 y1) .x2 y2) .x3 y3).setReg .q .rax rax
  let c := mem.foldl (fun c (j, q) => c.writeMem .q (v10Buf + BitVec.ofNat 64 (8 * j)) q) c
  c.setReg .q .rbx (v10Buf + off)

private def v10Agrees (t : Cpu) (n : Nat) (y1 y2 : BitVec 256) (f : BitVec 64) (w3 : BitVec 256) (wrax : BitVec 64)
    (wmx : BitVec 32) : Bool :=
  t.ms.isNone && v10Ymm t .x3 == w3 && v10Ymm t .x1 == y1 && v10Ymm t .x2 == y2
    && t.getReg .q .rax == wrax && t.mxcsr == wmx
    && (v10Rflags t.flags &&& 0x8d5) == (f &&& 0x8d5) && t.rip == 0x400000 + BitVec.ofNat 64 n


/-! ### The memory frame: `step` leaves `mem` unchanged, for a live state and an unlocked address (D361 prediction 1) -/

theorem v10_frame_shufbm (d s1 : XmmReg) (ea : Ea) (len : Nat) (s : Cpu) (h : Live s) (hl : ea.lock = false) :
    (step ⟨.vex (.vexshufbm d s1 ea), len⟩ s).mem = s.mem := by
  simp only [step, h, Cpu.stopped]
  split <;> simp_all [Cpu.setXmmVex128, Cpu.setRip, VexOp.anyLocked, Op.anyLocked]

theorem v10_frame_alignrm (d s1 : XmmReg) (ea : Ea) (imm : BitVec 8) (len : Nat) (s : Cpu) (h : Live s) (hl : ea.lock = false) :
    (step ⟨.vex (.vexalignrm d s1 ea imm), len⟩ s).mem = s.mem := by
  simp only [step, h, Cpu.stopped]
  split <;> simp_all [Cpu.setXmmVex128, Cpu.setRip, VexOp.anyLocked, Op.anyLocked]

theorem v10_frame_parithm (op : VArithOp) (d s1 : XmmReg) (ea : Ea) (len : Nat) (s : Cpu) (h : Live s) (hl : ea.lock = false) :
    (step ⟨.vex (.vexparithm op d s1 ea), len⟩ s).mem = s.mem := by
  simp only [step, h, Cpu.stopped]
  split <;> simp_all [Cpu.halt, Cpu.withSimd, Cpu.setXmmVex128, Cpu.setRip, VexOp.anyLocked, Op.anyLocked, apply_ite Cpu.mem]

theorem v10_frame_parithm256 (op : VArithOp) (d s1 : XmmReg) (ea : Ea) (len : Nat) (s : Cpu) (h : Live s) (hl : ea.lock = false) :
    (step ⟨.vex (.vexparithm256 op d s1 ea), len⟩ s).mem = s.mem := by
  simp only [step, h, Cpu.stopped]
  split <;> simp_all [Cpu.halt, Cpu.withSimd, Cpu.setYmm, Cpu.setRip, VexOp.anyLocked, Op.anyLocked, apply_ite Cpu.mem]

theorem v10_frame_sraxm (w : VShiftW) (d s1 : XmmReg) (ea : Ea) (len : Nat) (s : Cpu) (h : Live s) (hl : ea.lock = false) :
    (step ⟨.vex (.vexsraxm w d s1 ea), len⟩ s).mem = s.mem := by
  simp only [step, h, Cpu.stopped]
  split <;> simp_all [Cpu.halt, Cpu.setXmmVex128, Cpu.setRip, VexOp.anyLocked, Op.anyLocked] <;> split <;> simp

theorem v10_frame_sraxm256 (w : VShiftW) (d s1 : XmmReg) (ea : Ea) (len : Nat) (s : Cpu) (h : Live s) (hl : ea.lock = false) :
    (step ⟨.vex (.vexsraxm256 w d s1 ea), len⟩ s).mem = s.mem := by
  simp only [step, h, Cpu.stopped]
  split <;> simp_all [Cpu.halt, Cpu.setYmm, Cpu.setRip, VexOp.anyLocked, Op.anyLocked] <;> split <;> simp

