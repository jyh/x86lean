/-
# Tests.AnchorsVexSil — D345 (V7): the VEX.128 and VEX.256 twins of eleven main-table forms, against a processor

A NEW metered unit (D345 prediction 3), judged once against an absolute registration measured on its own machine
(`scripts/kernel_ceilings.txt`, `scripts/ku_delta_budget.txt`).

The block between the markers is GENERATED by `hwprobe/mk_vexsil_anchors.py` (`--check` gates it byte for byte).

LANE. Personal lane, public sources only.
-/
import X86

namespace X86.Tests.VexSil
open X86

/-! ## D345 (V7) — VSHUFPS, VPSRAD, VPSRAW, VADDPS, VSUBPS, VMULPS, VPUNPCKLWD, VPUNPCKHWD, VPUNPCKLBW, VPACKUSWB,
VPMOVMSKB at VEX.128 and VEX.256, against a processor's reading

⚠️ NONE OF THESE HAS A DIFFERENTIAL PARTNER: ACL2 x86isa refuses all 26 encodings.  So the rows below — run by
`hwprobe/vexsil_probe.c` on an Intel and an AMD processor, derived from the SDM's rules by `hwprobe/mk_vexsil_rows.py` and
held there row by row to an independent textbook — are the only check of this model's numbers for them, and every row is
pinned.

The pre-state is the probe's (`hwprobe/vexsil_ops.S`): YMM1, YMM2 and YMM3 are each the row's 256 bits, RAX is the row's
`rax`, MXCSR the row's `mx` (every exception masked, RC rotating) and the six arithmetic flags the row's `f`.  A row
agrees when the step did not refuse, YMM3 holds the row's 256 bits, YMM1 and YMM2 are unchanged in all 256 bits, RAX
holds the row's `wrax`, MXCSR is `mx` with the row's six sticky flags ORed in, the six flags are exactly `f` ("Flags
Affected: None"), and RIP moved by the instruction's length. -/

/-- The six arithmetic flags of an RFLAGS image (CF PF AF ZF SF OF at bits 0 2 4 6 7 11); DF stays clear. -/
private def v7Flags (f : BitVec 64) : Flags :=
  ⟨f.getLsbD 0, f.getLsbD 2, f.getLsbD 4, f.getLsbD 6, f.getLsbD 7, f.getLsbD 11, false⟩

/-- The RFLAGS image of the flags this model keeps, at `flagFields`' positions. -/
private def v7Rflags (f : Flags) : BitVec 64 :=
  flagFields.foldl (fun acc r => acc ||| (if r.get f then (1 : BitVec 64) <<< r.bit else 0)) 0

/-- Load a whole 256-bit YMM register: the low half through `setXmm`, the upper half into `Xmms.hi`. -/
private def v7SetYmm (c : Cpu) (r : XmmReg) (y : BitVec 256) : Cpu :=
  let c := c.setXmm r (y.setWidth 128)
  { c with xmm := { c.xmm with hi := c.xmm.hi.set r ((y >>> 128).setWidth 128) } }

/-- The whole 256-bit YMM register. -/
private def v7Ymm (t : Cpu) (r : XmmReg) : BitVec 256 :=
  ((t.getYmmHi r).setWidth 256 <<< 128) ||| (t.getXmm r).setWidth 256

/-- `vexsil_ops.S`'s pre-state, at RIP 0x400000. -/
private def v7Pre (y1 y2 y3 : BitVec 256) (f : BitVec 64) (mx : BitVec 32) (rax : BitVec 64) : Cpu :=
  (v7SetYmm (v7SetYmm (v7SetYmm ({ flags := v7Flags f, rip := 0x400000, mxcsr := mx, oracle := Oracle.zero } : Cpu)
    .x1 y1) .x2 y2) .x3 y3).setReg .q .rax rax

private def v7Agrees (t : Cpu) (n : Nat) (y1 y2 : BitVec 256) (f : BitVec 64) (mx : BitVec 32) (w3 : BitVec 256)
    (wrax : BitVec 64) (wfl : BitVec 32) : Bool :=
  t.ms.isNone && v7Ymm t .x3 == w3 && v7Ymm t .x1 == y1 && v7Ymm t .x2 == y2
    && t.getReg .q .rax == wrax && t.mxcsr == (mx ||| wfl)
    && (v7Rflags t.flags &&& 0x8d5) == (f &&& 0x8d5) && t.rip == 0x400000 + BitVec.ofNat 64 n

/-- ⭐ NO NEW ARITHMETIC (D345 prediction 3), for the one VEX arm that cannot call a legacy function by name: the legacy
`pmovmskb` writes exactly `pmovmskbLane` of its source, so `vexmovmskb` and `vexmovmskb256` share its fold. -/
theorem legacy_pmovmskb_is_pmovmskbLane (s : Cpu) (dst : GPR) (src : XmmReg) (len : Nat) (h : s.stopped = false) :
    step ⟨.vmovmsk .b dst src, len⟩ s =
      (s.setReg .d dst (pmovmskbLane (s.getXmm src))).setRip (s.rip + BitVec.ofNat 64 len) := by
  simp [step, h, pmovmskbLane, VMovMskKind.laneBits]

