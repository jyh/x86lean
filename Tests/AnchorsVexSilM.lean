/-
# Tests.AnchorsVexSilM — D394 (wave G): the VEX scalar floating-point forms, against a processor

A NEW metered unit (D394 prediction 3), judged once against an absolute registration measured on its own machine
(`scripts/kernel_ceilings.txt`, `scripts/ku_delta_budget.txt`).

ONE generated block, gated byte for byte by `hwprobe/mk_vexsilm_anchors.py --check` (`Tests.AnchorsVexSilL`'s machinery).
The helpers below restate that module's, which are private there, with ONE addition: `vmAgrees` also reads the qwords a
memory row's operand spans AFTER the step, because the two store forms write memory.

LANE. Personal lane, public sources only.
-/
import X86

namespace X86.Tests.VexSilM

open X86

/-! ## D394 — wave G against a processor

⚠️ NONE OF THESE HAS A DIFFERENTIAL PARTNER: ACL2 x86isa refuses every VEX scalar-FP shape at every pre-state (D394 P1 and
reading 0). The rows below — run by `hwprobe/vexsilm_probe.c` against `vexsilm_rows.h`, derived by
`hwprobe/mk_vexsilm_rows.py` from the legacy B1/B2 reference and the SDM's VEX rule — are the only check of this model's
numbers for them, and every row is pinned. -/

/-- The six arithmetic flags of an RFLAGS image (CF PF AF ZF SF OF at bits 0 2 4 6 7 11); DF stays clear. -/
private def vmFlags (f : BitVec 64) : Flags :=
  ⟨f.getLsbD 0, f.getLsbD 2, f.getLsbD 4, f.getLsbD 6, f.getLsbD 7, f.getLsbD 11, false⟩

/-- The RFLAGS image of the flags this model keeps, at `flagFields`' positions. -/
private def vmRflags (f : Flags) : BitVec 64 :=
  flagFields.foldl (fun acc r => acc ||| (if r.get f then (1 : BitVec 64) <<< r.bit else 0)) 0

/-- Load a whole 256-bit YMM register: the low half through `setXmm`, the upper half into `Xmms.hi`. -/
private def vmSetYmm (c : Cpu) (r : XmmReg) (y : BitVec 256) : Cpu :=
  let c := c.setXmm r (y.setWidth 128)
  { c with xmm := { c.xmm with hi := c.xmm.hi.set r ((y >>> 128).setWidth 128) } }

/-- The whole 256-bit YMM register. -/
private def vmYmm (t : Cpu) (r : XmmReg) : BitVec 256 :=
  ((t.getYmmHi r).setWidth 256 <<< 128) ||| (t.getXmm r).setWidth 256

/-- Where the row's 64-byte buffer lives in the model's memory (any address does; the probe's is a stack object). -/
private def vmBuf : BitVec 64 := 0x10000

/-- `vexsilm_ops.S`'s pre-state (`vexsile_ops.S`'s frame), at RIP 0x400000: registers as V8c's, the operand's qwords written (`(index, value)` pairs), RBX =
`vmBuf + off`. -/
private def vmPre (y1 y2 y3 : BitVec 256) (f : BitVec 64) (mx : BitVec 32) (rax : BitVec 64) (mem : List (Nat × BitVec 64))
    (off : BitVec 64) : Cpu :=
  let c := (vmSetYmm (vmSetYmm (vmSetYmm ({ flags := vmFlags f, rip := 0x400000, mxcsr := mx, oracle := Oracle.zero }
    : Cpu) .x1 y1) .x2 y2) .x3 y3).setReg .q .rax rax
  let c := mem.foldl (fun c (j, q) => c.writeMem .q (vmBuf + BitVec.ofNat 64 (8 * j)) q) c
  c.setReg .q .rbx (vmBuf + off)

private def vmAgrees (t : Cpu) (n : Nat) (y1 y2 : BitVec 256) (f : BitVec 64) (w3 : BitVec 256) (wrax : BitVec 64)
    (wmx : BitVec 32) (wq : List (Nat × BitVec 64)) : Bool :=
  t.ms.isNone && vmYmm t .x3 == w3 && vmYmm t .x1 == y1 && vmYmm t .x2 == y2
    && t.getReg .q .rax == wrax && t.mxcsr == wmx
    && (vmRflags t.flags &&& 0x8d5) == (f &&& 0x8d5) && t.rip == 0x400000 + BitVec.ofNat 64 n
    && wq.all (fun (j, q) => t.readMem .q (vmBuf + BitVec.ofNat 64 (8 * j)) == q)

