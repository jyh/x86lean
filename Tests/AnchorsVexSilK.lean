/-
# Tests.AnchorsVexSilK — D384 (wave E): `psubsw`, `pavgw`, `pmuldq` and their VEX twins, against a processor

A NEW metered unit (D384 prediction 3), judged once against an absolute registration measured on its own machine
(`scripts/kernel_ceilings.txt`, `scripts/ku_delta_budget.txt`).

TWO generated blocks, each gated byte for byte by its generator's `--check`: the legacy forms' pins
(`hwprobe/mk_simda_anchors.py --set-c`, `Tests.AnchorsSimdB`'s machinery) and the VEX twins' pins
(`hwprobe/mk_vexsilk_anchors.py`, `Tests.AnchorsVexSilG`'s). The two helper sets below restate those modules', which
are private there. That memory is never written by a VEX memory form is `v8c_frame_binm` / `v8c_frame_binm256` in
`Tests.AnchorsVexSilC`, stated for every `VBinKind`.

LANE. Personal lane, public sources only.
-/
import X86

namespace X86.Tests.VexSilK
open X86

/-! ## D384 — wave E against a processor

⚠️ NONE OF THESE HAS A DIFFERENTIAL PARTNER: ACL2 x86isa refuses all nine probed encodings at every pre-state (D384 P1).
The rows below — run by `hwprobe/simda_probe.c` against `simdc_rows.h` and by `hwprobe/vexsile_probe.c` against
`vexsilk_rows.h`, derived from the SDM's rules by `hwprobe/mk_simda_rows.py --set-c` and `hwprobe/mk_vexsilk_rows.py`
— are the only check of this model's numbers for them, and every row is pinned.  A legacy row agrees as in
`Tests.AnchorsSimd`; a VEX row as in `Tests.AnchorsVexSilG`. -/

/-- The six arithmetic flags of an RFLAGS image (CF PF AF ZF SF OF at bits 0 2 4 6 7 11); DF stays clear —
`Tests.Anchors`' `w1bFlags`, restated because that one is private to its module. -/
private def v1aFlags (f : BitVec 64) : Flags :=
  ⟨f.getLsbD 0, f.getLsbD 2, f.getLsbD 4, f.getLsbD 6, f.getLsbD 7, f.getLsbD 11, false⟩

/-- The RFLAGS image of the flags this model keeps, at `flagFields`' positions (`Tests.Anchors`' `b0Rflags`). -/
private def v1aRflags (f : Flags) : BitVec 64 :=
  flagFields.foldl (fun acc r => acc ||| (if r.get f then (1 : BitVec 64) <<< r.bit else 0)) 0

/-- `simdc_ops.S`'s pre-state (the same frame as D335's `simda_ops.S`), at RIP 0x400000 with the m128 source at 0x2000 (16-byte aligned). -/
private def v1aPre (a b : BitVec 128) (f : BitVec 64) : Cpu :=
  ((({ regs := ({} : Regs).set .rbx 0x2000, flags := v1aFlags f, mem := {}, rip := 0x400000,
       oracle := Oracle.zero } : Cpu).setXmm .x0 a).setXmm .x1 b).writeMem128 0x2000 b

private def v1aAgrees (t : Cpu) (n : Nat) (b : BitVec 128) (f : BitVec 64) (w : BitVec 128) : Bool :=
  t.ms.isNone && t.getXmm .x0 == w && t.getXmm .x1 == b && t.readMem128 0x2000 == b
    && (v1aRflags t.flags &&& 0x8d5) == (f &&& 0x8d5) && t.rip == 0x400000 + BitVec.ofNat 64 n

/-- The six arithmetic flags of an RFLAGS image (CF PF AF ZF SF OF at bits 0 2 4 6 7 11); DF stays clear. -/
private def vgFlags (f : BitVec 64) : Flags :=
  ⟨f.getLsbD 0, f.getLsbD 2, f.getLsbD 4, f.getLsbD 6, f.getLsbD 7, f.getLsbD 11, false⟩

/-- The RFLAGS image of the flags this model keeps, at `flagFields`' positions. -/
private def vgRflags (f : Flags) : BitVec 64 :=
  flagFields.foldl (fun acc r => acc ||| (if r.get f then (1 : BitVec 64) <<< r.bit else 0)) 0

/-- Load a whole 256-bit YMM register: the low half through `setXmm`, the upper half into `Xmms.hi`. -/
private def vgSetYmm (c : Cpu) (r : XmmReg) (y : BitVec 256) : Cpu :=
  let c := c.setXmm r (y.setWidth 128)
  { c with xmm := { c.xmm with hi := c.xmm.hi.set r ((y >>> 128).setWidth 128) } }

/-- The whole 256-bit YMM register. -/
private def vgYmm (t : Cpu) (r : XmmReg) : BitVec 256 :=
  ((t.getYmmHi r).setWidth 256 <<< 128) ||| (t.getXmm r).setWidth 256

/-- Where the row's 64-byte buffer lives in the model's memory (any address does; the probe's is a stack object). -/
private def vgBuf : BitVec 64 := 0x10000

/-- `vexsile_ops.S`'s pre-state, at RIP 0x400000: registers as V8c's, the operand's qwords written (`(index, value)` pairs), RBX =
`vgBuf + off`. -/
private def vgPre (y1 y2 y3 : BitVec 256) (f : BitVec 64) (mx : BitVec 32) (rax : BitVec 64) (mem : List (Nat × BitVec 64))
    (off : BitVec 64) : Cpu :=
  let c := (vgSetYmm (vgSetYmm (vgSetYmm ({ flags := vgFlags f, rip := 0x400000, mxcsr := mx, oracle := Oracle.zero }
    : Cpu) .x1 y1) .x2 y2) .x3 y3).setReg .q .rax rax
  let c := mem.foldl (fun c (j, q) => c.writeMem .q (vgBuf + BitVec.ofNat 64 (8 * j)) q) c
  c.setReg .q .rbx (vgBuf + off)

private def vgAgrees (t : Cpu) (n : Nat) (y1 y2 : BitVec 256) (f : BitVec 64) (w3 : BitVec 256) (wrax : BitVec 64)
    (wmx : BitVec 32) : Bool :=
  t.ms.isNone && vgYmm t .x3 == w3 && vgYmm t .x1 == y1 && vgYmm t .x2 == y2
    && t.getReg .q .rax == wrax && t.mxcsr == wmx
    && (vgRflags t.flags &&& 0x8d5) == (f &&& 0x8d5) && t.rip == 0x400000 + BitVec.ofNat 64 n


