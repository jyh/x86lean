namespace X86.Tests.Aes
open X86

/-! ## D342 (V4) — AESENC, AESENCLAST, VAESENC, VAESENCLAST, VPCLMULQDQ, VPSHUFB, VPALIGNR, VPSLLDQ, VPSRLDQ against a
processor's reading

⚠️ NONE OF THESE HAS A DIFFERENTIAL PARTNER: ACL2 x86isa refuses all nine at every pre-state.  So the rows below — run by
`hwprobe/aes_probe.c` on a hosted runner's processor, derived from the SDM's rules by `hwprobe/mk_aes_rows.py`, whose
known-answer rows come from a textbook FIPS-197 AES-128 (held to Appendices B and C.1) and a textbook carry-less product
(held to the Intel CLMUL white paper's test vectors) — are the only check of this model's numbers for them, and every row
is pinned.

The pre-state is the probe's (`hwprobe/aes_ops.S`): YMM1, YMM2 and YMM3 are each the row's 256 bits (every upper half
non-zero), and the six arithmetic flags are the row's `f`.  A row agrees when the step did not refuse, the destination
(XMM1 for the legacy forms, XMM3 for the VEX ones) holds the row's 256 bits — so a VEX form's zeroing and a legacy form's
preservation of bits 255:128 are both checked — the other two registers are unchanged in all 256 bits, the six flags
are exactly `f` ("Flags Affected: None"), and RIP moved by the instruction's length. -/

/-- The six arithmetic flags of an RFLAGS image (CF PF AF ZF SF OF at bits 0 2 4 6 7 11); DF stays clear —
`Tests.Anchors`' `w1bFlags`, restated because that one is private to its module. -/
private def v4Flags (f : BitVec 64) : Flags :=
  ⟨f.getLsbD 0, f.getLsbD 2, f.getLsbD 4, f.getLsbD 6, f.getLsbD 7, f.getLsbD 11, false⟩

/-- The RFLAGS image of the flags this model keeps, at `flagFields`' positions (`Tests.Anchors`' `b0Rflags`). -/
private def v4Rflags (f : Flags) : BitVec 64 :=
  flagFields.foldl (fun acc r => acc ||| (if r.get f then (1 : BitVec 64) <<< r.bit else 0)) 0

/-- Load a whole 256-bit YMM register: the low half through `setXmm`, the upper half into `Xmms.hi`. -/
private def v4SetYmm (c : Cpu) (r : XmmReg) (y : BitVec 256) : Cpu :=
  let c := c.setXmm r (y.setWidth 128)
  { c with xmm := { c.xmm with hi := c.xmm.hi.set r ((y >>> 128).setWidth 128) } }

/-- The whole 256-bit YMM register. -/
private def v4Ymm (t : Cpu) (r : XmmReg) : BitVec 256 :=
  ((t.getYmmHi r).setWidth 256 <<< 128) ||| (t.getXmm r).setWidth 256

/-- `aes_ops.S`'s pre-state, at RIP 0x400000. -/
private def v4Pre (y1 y2 y3 : BitVec 256) (f : BitVec 64) : Cpu :=
  v4SetYmm (v4SetYmm (v4SetYmm ({ flags := v4Flags f, rip := 0x400000, oracle := Oracle.zero } : Cpu) .x1 y1) .x2 y2)
    .x3 y3

private def v4Agrees (t : Cpu) (n : Nat) (d : XmmReg) (y1 y2 y3 : BitVec 256) (f : BitVec 64) (w : BitVec 256) : Bool :=
  t.ms.isNone && v4Ymm t d == w && v4Ymm t .x2 == y2
    && (if d == .x1 then v4Ymm t .x3 == y3 else v4Ymm t .x1 == y1)
    && (v4Rflags t.flags &&& 0x8d5) == (f &&& 0x8d5) && t.rip == 0x400000 + BitVec.ofNat 64 n

