/-
# Tests.AnchorsShuf — D336 (V1b): the shuffle, align, insert and extract pins, in a module of their own

Arm (A) of the 2026-10-10 kernel-cost fork: every silicon batch's pins go to their OWN metered module. Inside
`Tests.Anchors` these 220 `decide` pins moved that module's kernel unfoldings from 2,878,319 to 3,389,764 (D336's
Result). In a module of their own they are a NEW unit, judged against an absolute registration measured on its own
machine (`scripts/kernel_ceilings.txt`, `scripts/ku_delta_budget.txt`), and `Tests.Anchors` keeps its budget.

The block between the markers is GENERATED by `hwprobe/mk_shuf_anchors.py` (`--check` gates it byte for byte).

LANE. Personal lane, public sources only.
-/
import X86

namespace X86.Tests.Shuf
open X86

/-! ## D336 (V1b) — PSHUFB, PALIGNR, PINSRD/Q, PEXTRD/Q, pinned to hwprobe's rows

x86isa refuses all six (`scripts/oracle_availability.py`), so the rows `hwprobe/shuf_probe.c` runs on a processor are
the only check of this model's numbers for them. Each row compares all of XMM0, all of RAX and the six arithmetic flags
(none is written), exactly as the probe does. -/

/-- The six arithmetic flags of an RFLAGS image (CF PF AF ZF SF OF at bits 0 2 4 6 7 11); DF stays clear —
`Tests.Anchors`' `w1bFlags`, restated because that one is private to its module. -/
private def v1bFlags (f : BitVec 64) : Flags :=
  ⟨f.getLsbD 0, f.getLsbD 2, f.getLsbD 4, f.getLsbD 6, f.getLsbD 7, f.getLsbD 11, false⟩

/-- The RFLAGS image of the flags this model keeps, at `flagFields`' positions (`Tests.Anchors`' `b0Rflags`). -/
private def v1bRflags (f : Flags) : BitVec 64 :=
  flagFields.foldl (fun acc r => acc ||| (if r.get f then (1 : BitVec 64) <<< r.bit else 0)) 0

/-- `shuf_ops.S`'s pre-state, at RIP 0x400000: XMM0 = a, XMM1 = b, the 16-byte memory source (a copy of b) at 0x2000,
RCX = g, RAX the canary. -/
private def v1bPre (a b : BitVec 128) (g f : BitVec 64) : Cpu :=
  let r : Regs := ((({} : Regs).set .rax 0xc3c3c3c3c3c3c3c3).set .rcx g).set .rbx 0x2000
  ((({ regs := r, flags := v1bFlags f, mem := {}, rip := 0x400000, oracle := Oracle.zero } : Cpu).setXmm .x0 a).setXmm
    .x1 b).writeMem128 0x2000 b

private def v1bAgrees (t : Cpu) (n : Nat) (f : BitVec 64) (wr : BitVec 128) (wax : BitVec 64) : Bool :=
  t.ms.isNone && t.getXmm .x0 == wr && t.regs.get .rax == wax
    && (v1bRflags t.flags &&& 0x8d5) == (f &&& 0x8d5) && t.rip == 0x400000 + BitVec.ofNat 64 n

