/-
# Tests.AnchorsVexSilF — D371: VEX `vmovd`/`vmovq` between an XMM register and a GPR or memory, against a processor

A NEW metered unit (D371 prediction 3), judged once against an absolute registration measured on its own machine
(`scripts/kernel_ceilings.txt`, `scripts/ku_delta_budget.txt`).

The block between the markers is GENERATED by `hwprobe/mk_vexsilf_anchors.py` (`--check` gates it byte for byte).

LANE. Personal lane, public sources only.
-/
import X86

namespace X86.Tests.VexSilF
open X86

/-! ## D371 — VEX `vmovd`/`vmovq`: r → xmm, xmm → r, m → xmm, xmm → m, at 32 and 64 bits, against a processor's reading

⚠️ NONE OF THESE HAS A DIFFERENTIAL PARTNER: ACL2 x86isa refuses all eight encodings while it executes `vpxor m,xmm`
in the same run (D371 P1).  The rows below — run by `hwprobe/vexsilf_probe.c`, derived by `hwprobe/mk_vexsilf_rows.py`
and held there row by row to an independent textbook — are the only check of these numbers.

The pre-state is the probe's (`hwprobe/vexsilf_ops.S`, D361's PRE): YMM1-3, RAX and the flags from the row, MXCSR
0x1F80, the qwords the memory operand spans at `vfBuf`, and RBX = `vfBuf + off`.  A row agrees when the step did not
refuse, YMM3 holds the row's 256 bits (so the VEX.128 zeroing of bits 255:128 is read over a YMM3 seeded nonzero there),
YMM1 and YMM2 are unchanged, RAX is the row's, MXCSR is 0x1F80, the six flags are `f`, RIP moved by the instruction's
length, and — for a STORE row only — the spanned qwords read back as the expected buffer's.  The other forms' rows do
not read memory back: `vf_frame_movg` and `vf_frame_movgld` state `(step ⟨.vex op, len⟩ s).mem = s.mem` for a live
state (and, for the load, an unlocked address). -/

/-- The six arithmetic flags of an RFLAGS image (CF PF AF ZF SF OF at bits 0 2 4 6 7 11); DF stays clear. -/
private def vfFlags (f : BitVec 64) : Flags :=
  ⟨f.getLsbD 0, f.getLsbD 2, f.getLsbD 4, f.getLsbD 6, f.getLsbD 7, f.getLsbD 11, false⟩

/-- The RFLAGS image of the flags this model keeps, at `flagFields`' positions. -/
private def vfRflags (f : Flags) : BitVec 64 :=
  flagFields.foldl (fun acc r => acc ||| (if r.get f then (1 : BitVec 64) <<< r.bit else 0)) 0

/-- Load a whole 256-bit YMM register: the low half through `setXmm`, the upper half into `Xmms.hi`. -/
private def vfSetYmm (c : Cpu) (r : XmmReg) (y : BitVec 256) : Cpu :=
  let c := c.setXmm r (y.setWidth 128)
  { c with xmm := { c.xmm with hi := c.xmm.hi.set r ((y >>> 128).setWidth 128) } }

/-- The whole 256-bit YMM register. -/
private def vfYmm (t : Cpu) (r : XmmReg) : BitVec 256 :=
  ((t.getYmmHi r).setWidth 256 <<< 128) ||| (t.getXmm r).setWidth 256

/-- Where the row's 64-byte buffer lives in the model's memory (any address does; the probe's is a stack object). -/
private def vfBuf : BitVec 64 := 0x10000

/-- `vexsilf_ops.S`'s pre-state, at RIP 0x400000: registers as D361's, MXCSR 0x1F80, the operand's qwords written
(`(index, value)` pairs), RBX = `vfBuf + off`. -/
private def vfPre (y1 y2 y3 : BitVec 256) (f : BitVec 64) (rax : BitVec 64) (mem : List (Nat × BitVec 64))
    (off : BitVec 64) : Cpu :=
  let c := (vfSetYmm (vfSetYmm (vfSetYmm ({ flags := vfFlags f, rip := 0x400000, mxcsr := 0x1f80, oracle := Oracle.zero }
    : Cpu) .x1 y1) .x2 y2) .x3 y3).setReg .q .rax rax
  let c := mem.foldl (fun c (j, q) => c.writeMem .q (vfBuf + BitVec.ofNat 64 (8 * j)) q) c
  c.setReg .q .rbx (vfBuf + off)

private def vfAgrees (t : Cpu) (n : Nat) (y1 y2 : BitVec 256) (f : BitVec 64) (w3 : BitVec 256) (wrax : BitVec 64)
    (wq : List (Nat × BitVec 64)) : Bool :=
  t.ms.isNone && vfYmm t .x3 == w3 && vfYmm t .x1 == y1 && vfYmm t .x2 == y2
    && t.getReg .q .rax == wrax && t.mxcsr == 0x1f80
    && (vfRflags t.flags &&& 0x8d5) == (f &&& 0x8d5) && t.rip == 0x400000 + BitVec.ofNat 64 n
    && wq.all (fun (j, q) => t.readMem .q (vfBuf + BitVec.ofNat 64 (8 * j)) == q)


/-! ### The memory frame: `step` leaves `mem` unchanged for the register and load forms (D371) -/

theorem vf_frame_movg (toXmm : Bool) (sz : Size) (x : XmmReg) (r : GPR) (len : Nat) (s : Cpu) (h : Live s) :
    (step ⟨.vex (.vexmovg toXmm sz x r), len⟩ s).mem = s.mem := by
  simp only [step, h, Cpu.stopped]
  split <;> simp_all [Cpu.setXmmVex128, Cpu.setRip, Cpu.setReg, VexOp.anyLocked, Op.anyLocked] <;> split <;> simp_all

theorem vf_frame_movgld (sz : Size) (d : XmmReg) (ea : Ea) (len : Nat) (s : Cpu) (h : Live s) (hl : ea.lock = false) :
    (step ⟨.vex (.vexmovgld sz d ea), len⟩ s).mem = s.mem := by
  simp only [step, h, Cpu.stopped]
  split <;> simp_all [Cpu.setXmmVex128, Cpu.setRip, VexOp.anyLocked, Op.anyLocked]

