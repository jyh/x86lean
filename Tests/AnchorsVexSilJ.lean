import X86

namespace X86.Tests.VexSilJ
open X86

/-! ## D379 — PABSB PABSW PABSD and PMULLD (legacy: register and aligned m128), and VPABSB VPABSW VPABSD VPMULLD
(VEX.128 and VEX.256: register and unaligned memory), against a processor's reading

⚠️ NONE OF THESE HAS A DIFFERENTIAL PARTNER: ACL2 x86isa refuses all ten encodings probed while it executes
`vpaddw ymm` and `vpxor xmm` in the same run (D379 P1).  The rows below — run by `hwprobe/vexsilf_probe.c` against
`vexsilj_rows.h`, derived by `hwprobe/mk_vexsilj_rows.py` and re-derived there from byte lists — are the only check
of these numbers.

A row agrees when the step did not refuse, YMM3 holds the row's 256 bits (for a legacy form its upper half PRESERVED,
for VEX.128 ZEROED), YMM1 and YMM2 are unchanged, RAX and MXCSR are unchanged, the six flags are `f`, and RIP moved by
the instruction's length.  No form here writes memory: the frame theorems below. -/

/-- The six arithmetic flags of an RFLAGS image (CF PF AF ZF SF OF at bits 0 2 4 6 7 11); DF stays clear. -/
private def vjFlags (f : BitVec 64) : Flags :=
  ⟨f.getLsbD 0, f.getLsbD 2, f.getLsbD 4, f.getLsbD 6, f.getLsbD 7, f.getLsbD 11, false⟩

/-- The RFLAGS image of the flags this model keeps, at `flagFields`' positions. -/
private def vjRflags (f : Flags) : BitVec 64 :=
  flagFields.foldl (fun acc r => acc ||| (if r.get f then (1 : BitVec 64) <<< r.bit else 0)) 0

/-- Load a whole 256-bit YMM register: the low half through `setXmm`, the upper half into `Xmms.hi`. -/
private def vjSetYmm (c : Cpu) (r : XmmReg) (y : BitVec 256) : Cpu :=
  let c := c.setXmm r (y.setWidth 128)
  { c with xmm := { c.xmm with hi := c.xmm.hi.set r ((y >>> 128).setWidth 128) } }

/-- The whole 256-bit YMM register. -/
private def vjYmm (t : Cpu) (r : XmmReg) : BitVec 256 :=
  ((t.getYmmHi r).setWidth 256 <<< 128) ||| (t.getXmm r).setWidth 256

/-- Where the row's 64-byte buffer lives in the model's memory (any address does; the probe's is a stack object). -/
private def vjBuf : BitVec 64 := 0x10000

/-- `vexsilj_ops.S`'s pre-state (D371's frame, `vexsilf_ops.S`), at RIP 0x400000: registers as D361's, MXCSR 0x1F80, the operand's qwords written
(`(index, value)` pairs), RBX = `vjBuf + off`. -/
private def vjPre (y1 y2 y3 : BitVec 256) (f : BitVec 64) (rax : BitVec 64) (mem : List (Nat × BitVec 64))
    (off : BitVec 64) : Cpu :=
  let c := (vjSetYmm (vjSetYmm (vjSetYmm ({ flags := vjFlags f, rip := 0x400000, mxcsr := 0x1f80, oracle := Oracle.zero }
    : Cpu) .x1 y1) .x2 y2) .x3 y3).setReg .q .rax rax
  let c := mem.foldl (fun c (j, q) => c.writeMem .q (vjBuf + BitVec.ofNat 64 (8 * j)) q) c
  c.setReg .q .rbx (vjBuf + off)

private def vjAgrees (t : Cpu) (n : Nat) (y1 y2 : BitVec 256) (f : BitVec 64) (w3 : BitVec 256) (wrax : BitVec 64)
    (wq : List (Nat × BitVec 64)) : Bool :=
  t.ms.isNone && vjYmm t .x3 == w3 && vjYmm t .x1 == y1 && vjYmm t .x2 == y2
    && t.getReg .q .rax == wrax && t.mxcsr == 0x1f80
    && (vjRflags t.flags &&& 0x8d5) == (f &&& 0x8d5) && t.rip == 0x400000 + BitVec.ofNat 64 n
    && wq.all (fun (j, q) => t.readMem .q (vjBuf + BitVec.ofNat 64 (8 * j)) == q)


/-! ### The memory frame: `step` leaves `mem` unchanged for every abs form (D379); `pmulld` is a `VBinKind`, framed
where `vbin`'s kinds are -/

theorem vj_frame_vabs (w : VAbsW) (d s1 : XmmReg) (len : Nat) (s : Cpu) (h : Live s) :
    (step ⟨.vabs w d s1, len⟩ s).mem = s.mem := by
  simp only [step, h, Cpu.stopped]
  split <;> simp_all [Cpu.setXmm, Cpu.setRip, Op.anyLocked]

theorem vj_frame_vabsm (w : VAbsW) (d : XmmReg) (ea : Ea) (len : Nat) (s : Cpu) (h : Live s) (hl : ea.lock = false) :
    (step ⟨.vabsm w d ea, len⟩ s).mem = s.mem := by
  simp only [step, h, Cpu.stopped]
  split <;> simp_all [Cpu.setXmm, Cpu.setRip, Cpu.halt, Op.anyLocked] <;> split <;> simp_all [Cpu.halt]

theorem vj_frame_vexabs (w : VAbsW) (d s1 : XmmReg) (len : Nat) (s : Cpu) (h : Live s) :
    (step ⟨.vex (.vexabs w d s1), len⟩ s).mem = s.mem := by
  simp only [step, h, Cpu.stopped]
  split <;> simp_all [Cpu.setXmmVex128, Cpu.setRip, VexOp.anyLocked, Op.anyLocked]

theorem vj_frame_vexabs256 (w : VAbsW) (d s1 : XmmReg) (len : Nat) (s : Cpu) (h : Live s) :
    (step ⟨.vex (.vexabs256 w d s1), len⟩ s).mem = s.mem := by
  simp only [step, h, Cpu.stopped]
  split <;> simp_all [Cpu.setYmm, Cpu.setRip, VexOp.anyLocked, Op.anyLocked]

