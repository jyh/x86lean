/-
# Tests.AnchorsVexSilI — D376: `movntdqa` and the VEX.128 half-moves, against a processor

A NEW metered unit (D376 prediction 3), judged once against an absolute registration measured on its own machine
(`scripts/kernel_ceilings.txt`, `scripts/ku_delta_budget.txt`).

The block between the markers is GENERATED by `hwprobe/mk_vexsili_anchors.py` (`--check` gates it byte for byte). The
helpers restate `Tests.AnchorsVexSilF`'s (D371), private to that module, renamed `vi…`.

LANE. Personal lane, public sources only.
-/
import X86

namespace X86.Tests.VexSilI
open X86

/-! ## D376 — MOVNTDQA (m128 → xmm, aligned) and VMOVHPS VMOVHPD VMOVLPS VMOVLPD (m64 load, three-operand; and store),
against a processor's reading

⚠️ NONE OF THESE HAS A DIFFERENTIAL PARTNER: ACL2 x86isa refuses all nine encodings while it executes legacy
`movhps`/`movlps` loads, `vpxor m,xmm` and `vpaddw ymm` in the same run (D376 P1).  The rows below — run by
`hwprobe/vexsilf_probe.c` against `vexsili_rows.h`, derived by `hwprobe/mk_vexsili_rows.py` and re-derived there from
byte lists — are the only check of these numbers.

A row agrees when the step did not refuse, YMM3 holds the row's 256 bits (for `movntdqa` its upper half PRESERVED, for a
VEX load ZEROED, for a store unchanged), YMM1 and YMM2 are unchanged, RAX and MXCSR are unchanged, the six flags are `f`,
RIP moved by the instruction's length, and, for a store, the qwords its 8 bytes span equal the expected buffer's.  The
two loads leave memory alone: the frame theorems below.  ⚠️ What a store writes OUTSIDE the qwords it spans is not
checked per row; it is `writeMem .q` by definition, and the probe compares the whole 64-byte buffer on silicon. -/

/-- The six arithmetic flags of an RFLAGS image (CF PF AF ZF SF OF at bits 0 2 4 6 7 11); DF stays clear. -/
private def viFlags (f : BitVec 64) : Flags :=
  ⟨f.getLsbD 0, f.getLsbD 2, f.getLsbD 4, f.getLsbD 6, f.getLsbD 7, f.getLsbD 11, false⟩

/-- The RFLAGS image of the flags this model keeps, at `flagFields`' positions. -/
private def viRflags (f : Flags) : BitVec 64 :=
  flagFields.foldl (fun acc r => acc ||| (if r.get f then (1 : BitVec 64) <<< r.bit else 0)) 0

/-- Load a whole 256-bit YMM register: the low half through `setXmm`, the upper half into `Xmms.hi`. -/
private def viSetYmm (c : Cpu) (r : XmmReg) (y : BitVec 256) : Cpu :=
  let c := c.setXmm r (y.setWidth 128)
  { c with xmm := { c.xmm with hi := c.xmm.hi.set r ((y >>> 128).setWidth 128) } }

/-- The whole 256-bit YMM register. -/
private def viYmm (t : Cpu) (r : XmmReg) : BitVec 256 :=
  ((t.getYmmHi r).setWidth 256 <<< 128) ||| (t.getXmm r).setWidth 256

/-- Where the row's 64-byte buffer lives in the model's memory (any address does; the probe's is a stack object). -/
private def viBuf : BitVec 64 := 0x10000

/-- `vexsili_ops.S`'s pre-state (D371's frame, `vexsilf_ops.S`), at RIP 0x400000: registers as D361's, MXCSR 0x1F80, the operand's qwords written
(`(index, value)` pairs), RBX = `viBuf + off`. -/
private def viPre (y1 y2 y3 : BitVec 256) (f : BitVec 64) (rax : BitVec 64) (mem : List (Nat × BitVec 64))
    (off : BitVec 64) : Cpu :=
  let c := (viSetYmm (viSetYmm (viSetYmm ({ flags := viFlags f, rip := 0x400000, mxcsr := 0x1f80, oracle := Oracle.zero }
    : Cpu) .x1 y1) .x2 y2) .x3 y3).setReg .q .rax rax
  let c := mem.foldl (fun c (j, q) => c.writeMem .q (viBuf + BitVec.ofNat 64 (8 * j)) q) c
  c.setReg .q .rbx (viBuf + off)

private def viAgrees (t : Cpu) (n : Nat) (y1 y2 : BitVec 256) (f : BitVec 64) (w3 : BitVec 256) (wrax : BitVec 64)
    (wq : List (Nat × BitVec 64)) : Bool :=
  t.ms.isNone && viYmm t .x3 == w3 && viYmm t .x1 == y1 && viYmm t .x2 == y2
    && t.getReg .q .rax == wrax && t.mxcsr == 0x1f80
    && (viRflags t.flags &&& 0x8d5) == (f &&& 0x8d5) && t.rip == 0x400000 + BitVec.ofNat 64 n
    && wq.all (fun (j, q) => t.readMem .q (viBuf + BitVec.ofNat 64 (8 * j)) == q)


/-! ### The memory frame: `step` leaves `mem` unchanged for both loads (D376) -/

theorem vi_frame_loadnt (d : XmmReg) (ea : Ea) (len : Nat) (s : Cpu) (h : Live s) (hl : ea.lock = false) :
    (step ⟨.vloadnt d ea, len⟩ s).mem = s.mem := by
  simp only [step, h, Cpu.stopped]
  split <;> simp_all [Cpu.setXmm, Cpu.setRip, Cpu.halt, Op.anyLocked] <;> split <;> simp_all [Cpu.halt]

theorem vi_frame_vexloadq (hf : VHalf) (k : VQuadKind) (d s1 : XmmReg) (ea : Ea) (len : Nat) (s : Cpu) (h : Live s)
    (hl : ea.lock = false) :
    (step ⟨.vex (.vexloadq hf k d s1 ea), len⟩ s).mem = s.mem := by
  simp only [step, h, Cpu.stopped]
  split <;> simp_all [Cpu.setXmmVex128, Cpu.setRip, VexOp.anyLocked, Op.anyLocked] <;> cases hf <;> simp_all

