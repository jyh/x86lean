/-
# Tests.AnchorsMmxSil — D407: the MMX forms x86isa cannot execute, pinned against a processor's reading

PMAXSW, PSADBW, PAVGB and PSHUFW at %mm have no handler in ACL2 x86isa's inst-listing (the slot is `'NIL`), so no
differential vector can carry them and these rows are the only check of the model's numbers for them. Each row is run by
`hwprobe/mmxsil_probe.c` on the CI runners' processors and derived from the SDM by `hwprobe/mk_mmxsil_rows.py`. A module of
its own (D311: one test module per witness family), so it is a NEW unit judged against its own registration.
The block between the markers is GENERATED by `hwprobe/mk_mmxsil_anchors.py` (`--check` gates it byte for byte).
LANE. Personal lane, public sources only.
-/
import X86

namespace X86.Tests.MmxSil
open X86

/-- The probe's pre-state: %mm0 = DEST, %mm1 = SRC, and the m64 at RBX = 0x2000 holds the same SRC, at RIP 0x400000. -/
private def d407Pre (a b : BitVec 64) : Cpu :=
  ((({ regs := ({} : Regs).set .rbx 0x2000, flags := {}, mem := {}, rip := 0x400000,
       oracle := Oracle.zero } : Cpu).setMm .m0 a).setMm .m1 b).writeMem .q 0x2000 b

/-- A row agrees when the step did not refuse, %mm0 is the row's 64 bits, %mm1 and the m64 are unchanged, and RIP moved by
the instruction's length. -/
private def d407Agrees (t : Cpu) (n : Nat) (b w : BitVec 64) : Bool :=
  t.ms.isNone && t.getMm .m0 == w && t.getMm .m1 == b && t.readMem .q 0x2000 == b
    && t.rip == 0x400000 + BitVec.ofNat 64 n

-- ⟦D407 MMX SILICON PINS BEGIN — GENERATED by hwprobe/mk_mmxsil_anchors.py; change mk_mmxsil_rows.py and regenerate⟧
