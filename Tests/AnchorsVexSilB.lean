/-! ## D348 (V8b) — VPMADDWD, VPMULHRSW, VPMADDUBSW, VPACKSSDW at VEX.128 and VEX.256, against a processor's reading

⚠️ NONE OF THESE HAS A DIFFERENTIAL PARTNER: ACL2 x86isa refuses all 8 encodings.  So the rows below — run by
`hwprobe/vexsilb_probe.c` on an Intel and an AMD processor, derived from the SDM's rules by `hwprobe/mk_vexsilb_rows.py`
and held there row by row to an independent textbook — are the only check of this model's numbers for them, and every
row is pinned.

The pre-state is the probe's (`hwprobe/vexsilb_ops.S`): YMM1, YMM2 and YMM3 are each the row's 256 bits, RAX is the
row's `rax`, MXCSR the row's `mx` and the six arithmetic flags the row's `f`.  A row agrees when the step did not refuse,
YMM3 holds the row's 256 bits, YMM1 and YMM2 are unchanged in all 256 bits, RAX holds `wrax` and MXCSR `wmx` (both the
pre-state's: the four forms are integer), the six flags are exactly `f` ("Flags Affected: None"), and RIP moved by the
instruction's length.  The helpers are V7's (`Tests/AnchorsVexSil.lean`), restated, because that unit's are private. -/

/-- The six arithmetic flags of an RFLAGS image (CF PF AF ZF SF OF at bits 0 2 4 6 7 11); DF stays clear. -/
private def v8bFlags (f : BitVec 64) : Flags :=
  ⟨f.getLsbD 0, f.getLsbD 2, f.getLsbD 4, f.getLsbD 6, f.getLsbD 7, f.getLsbD 11, false⟩

/-- The RFLAGS image of the flags this model keeps, at `flagFields`' positions. -/
private def v8bRflags (f : Flags) : BitVec 64 :=
  flagFields.foldl (fun acc r => acc ||| (if r.get f then (1 : BitVec 64) <<< r.bit else 0)) 0

/-- Load a whole 256-bit YMM register: the low half through `setXmm`, the upper half into `Xmms.hi`. -/
private def v8bSetYmm (c : Cpu) (r : XmmReg) (y : BitVec 256) : Cpu :=
  let c := c.setXmm r (y.setWidth 128)
  { c with xmm := { c.xmm with hi := c.xmm.hi.set r ((y >>> 128).setWidth 128) } }

/-- The whole 256-bit YMM register. -/
private def v8bYmm (t : Cpu) (r : XmmReg) : BitVec 256 :=
  ((t.getYmmHi r).setWidth 256 <<< 128) ||| (t.getXmm r).setWidth 256

/-- `vexsilb_ops.S`'s pre-state, at RIP 0x400000. -/
private def v8bPre (y1 y2 y3 : BitVec 256) (f : BitVec 64) (mx : BitVec 32) (rax : BitVec 64) : Cpu :=
  (v8bSetYmm (v8bSetYmm (v8bSetYmm ({ flags := v8bFlags f, rip := 0x400000, mxcsr := mx, oracle := Oracle.zero } : Cpu)
    .x1 y1) .x2 y2) .x3 y3).setReg .q .rax rax

private def v8bAgrees (t : Cpu) (n : Nat) (y1 y2 : BitVec 256) (f : BitVec 64) (w3 : BitVec 256) (wrax : BitVec 64)
    (wmx : BitVec 32) : Bool :=
  t.ms.isNone && v8bYmm t .x3 == w3 && v8bYmm t .x1 == y1 && v8bYmm t .x2 == y2
    && t.getReg .q .rax == wrax && t.mxcsr == wmx
    && (v8bRflags t.flags &&& 0x8d5) == (f &&& 0x8d5) && t.rip == 0x400000 + BitVec.ofNat 64 n

