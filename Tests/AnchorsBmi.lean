/-! ## D334 (W1c) — ANDN, BEXTR, BLSMSK, BLSR, BZHI, PDEP, PEXT, RORX and MOVNTI against a processor's reading

⚠️ NONE OF THESE HAS A DIFFERENTIAL PARTNER: ACL2 x86isa refuses every one at every pre-state.  So the rows below —
run by `hwprobe/int_probe.c` on a hosted runner's processor, derived from the SDM's rules by `hwprobe/mk_int_rows.py` —
are the only check of this model's numbers for them, and every row is pinned.

The pre-state is the probe's (`hwprobe/int_ops.S`): RAX = R8 = R9 = a (the canary for every BMI row; the stored value
for MOVNTI), RCX = b, RDX = d, the memory operand at RBX holds the same b, and the six arithmetic flags are the row's
`f`.  A row agrees when the step did not refuse, R8 (or, for MOVNTI, the quadword at RBX) is `w0`, R9 is `w1` (the
untouched canary — no W1c form names R9), the flags agree with `wf` on the bits `fm` names — the six, less those the
SDM leaves undefined for the form — and RIP moved by the instruction's length.  ⚠️ The undefined bits are drawn from
`Oracle.zero` here and are NOT compared, exactly as the probe does not compare them. -/

/-- The six arithmetic flags of an RFLAGS image (CF PF AF ZF SF OF at bits 0 2 4 6 7 11); DF stays clear —
`Tests.Anchors`' `w1bFlags`, restated because that one is private to its module. -/
private def w1cFlags (f : BitVec 64) : Flags :=
  ⟨f.getLsbD 0, f.getLsbD 2, f.getLsbD 4, f.getLsbD 6, f.getLsbD 7, f.getLsbD 11, false⟩

/-- The RFLAGS image of the flags this model keeps, at `flagFields`' positions (`Tests.Anchors`' `b0Rflags`). -/
private def w1cRflags (f : Flags) : BitVec 64 :=
  flagFields.foldl (fun acc r => acc ||| (if r.get f then (1 : BitVec 64) <<< r.bit else 0)) 0

/-- `int_ops.S`'s pre-state for the W1c rows, at RIP 0x400000 with the memory operand at 0x2000. -/
private def w1cPre (a b d f : BitVec 64) : Cpu :=
  let r0 : Regs := (((({} : Regs).set .rax a).set .rcx b).set .rdx d).set .rbx 0x2000
  let r : Regs := (r0.set .r8 a).set .r9 a
  ({ regs := r, flags := w1cFlags f, mem := {}, rip := 0x400000, oracle := Oracle.zero } : Cpu).writeMem .q 0x2000 b

private def w1cAgrees (t : Cpu) (memOut : Bool) (n : Nat) (w0 w1 wf fm : BitVec 64) : Bool :=
  t.ms.isNone && (if memOut then t.readMem .q 0x2000 else t.regs.get .r8) == w0 && t.regs.get .r9 == w1
    && (w1cRflags t.flags &&& fm) == (wf &&& fm) && t.rip == 0x400000 + BitVec.ofNat 64 n

