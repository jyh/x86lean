/-! ## D350 (V8c) — VPBROADCASTD (xmm, m32) and the m128/m256 forms of VPMADDWD, VPMULHRSW, VPMADDUBSW, VPACKSSDW,
against a processor's reading

⚠️ NONE OF THESE HAS A DIFFERENTIAL PARTNER: ACL2 x86isa refuses all 12 encodings while it executes `vpxor m,xmm` in the
same run.  The rows below — run by `hwprobe/vexsilc_probe.c` on an Intel and an AMD processor, derived by
`hwprobe/mk_vexsilc_rows.py` and held there row by row to an independent textbook — are the only check of these numbers.

The pre-state is the probe's (`hwprobe/vexsilc_ops.S`): YMM1-3, RAX, MXCSR and the flags from the row, the row's 64-byte
buffer at `v8cBuf` as eight little-endian qwords, and RBX = `v8cBuf + off`.  A row agrees when the step did not refuse, YMM3
holds the row's 256 bits, YMM1 and YMM2 are unchanged, RAX and MXCSR are the row's, the six flags are `f`, RIP moved by the
instruction's length, and all eight qwords of the buffer read back unchanged. -/

/-- The six arithmetic flags of an RFLAGS image (CF PF AF ZF SF OF at bits 0 2 4 6 7 11); DF stays clear. -/
private def v8cFlags (f : BitVec 64) : Flags :=
  ⟨f.getLsbD 0, f.getLsbD 2, f.getLsbD 4, f.getLsbD 6, f.getLsbD 7, f.getLsbD 11, false⟩

/-- The RFLAGS image of the flags this model keeps, at `flagFields`' positions. -/
private def v8cRflags (f : Flags) : BitVec 64 :=
  flagFields.foldl (fun acc r => acc ||| (if r.get f then (1 : BitVec 64) <<< r.bit else 0)) 0

/-- Load a whole 256-bit YMM register: the low half through `setXmm`, the upper half into `Xmms.hi`. -/
private def v8cSetYmm (c : Cpu) (r : XmmReg) (y : BitVec 256) : Cpu :=
  let c := c.setXmm r (y.setWidth 128)
  { c with xmm := { c.xmm with hi := c.xmm.hi.set r ((y >>> 128).setWidth 128) } }

/-- The whole 256-bit YMM register. -/
private def v8cYmm (t : Cpu) (r : XmmReg) : BitVec 256 :=
  ((t.getYmmHi r).setWidth 256 <<< 128) ||| (t.getXmm r).setWidth 256

/-- Where the row's 64-byte buffer lives in the model's memory (any address does; the probe's is a stack object). -/
private def v8cBuf : BitVec 64 := 0x10000

/-- `vexsilc_ops.S`'s pre-state, at RIP 0x400000: registers as V8b's, the buffer written, RBX = `v8cBuf + off`. -/
private def v8cPre (y1 y2 y3 : BitVec 256) (f : BitVec 64) (mx : BitVec 32) (rax : BitVec 64) (mem : List (BitVec 64))
    (off : BitVec 64) : Cpu :=
  let c := (v8cSetYmm (v8cSetYmm (v8cSetYmm ({ flags := v8cFlags f, rip := 0x400000, mxcsr := mx, oracle := Oracle.zero }
    : Cpu) .x1 y1) .x2 y2) .x3 y3).setReg .q .rax rax
  let c := (mem.zipIdx).foldl (fun c (q, j) => c.writeMem .q (v8cBuf + BitVec.ofNat 64 (8 * j)) q) c
  c.setReg .q .rbx (v8cBuf + off)

private def v8cAgrees (t : Cpu) (n : Nat) (y1 y2 : BitVec 256) (f : BitVec 64) (w3 : BitVec 256) (wrax : BitVec 64)
    (wmx : BitVec 32) (mem : List (BitVec 64)) : Bool :=
  (mem.zipIdx).all (fun (q, j) => t.readMem .q (v8cBuf + BitVec.ofNat 64 (8 * j)) == q) &&
  t.ms.isNone && v8cYmm t .x3 == w3 && v8cYmm t .x1 == y1 && v8cYmm t .x2 == y2
    && t.getReg .q .rax == wrax && t.mxcsr == wmx
    && (v8cRflags t.flags &&& 0x8d5) == (f &&& 0x8d5) && t.rip == 0x400000 + BitVec.ofNat 64 n

